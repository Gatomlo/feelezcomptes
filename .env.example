# Copie ce fichier en ".env" puis modifie les valeurs avant de démarrer le serveur.

# Port d'écoute du serveur Node.js
PORT=3000

# Chaîne aléatoire et longue utilisée pour signer les sessions.
# Génère-en une avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Mets "true" uniquement quand le site est servi en HTTPS (obligatoire en production).
# En local avec http://localhost, laisse "false" sinon la connexion ne fonctionnera pas.
COOKIE_SECURE=false

# Identifiants créés automatiquement au tout premier démarrage (si la base est vide).
# Change le mot de passe tout de suite après le premier lancement (page Réglages > Compte),
# ou avec : npm run set-password -- <identifiant> <nouveau_mot_de_passe>
ADMIN_USERNAME=foyer
ADMIN_PASSWORD=change-me-now

# Dossier où sera créé le fichier de base de données SQLite (data/app.db).
DATA_DIR=./data

# Notifications push des dépenses planifiées : les clés VAPID sont générées toutes seules
# au premier démarrage (gardées dans la base). Réglages facultatifs :
# VAPID_SUBJECT=mailto:toi@exemple.be
# Fuseau horaire et heure à partir de laquelle le rappel du jour J est envoyé
APP_TZ=Europe/Brussels
PUSH_HOUR=9
